# ==============================================================================
# SMARTCAMPUS 360 ENVIRONMENT CONFIGURATION
# ==============================================================================
# If these variables are not provided, SmartCampus 360 will automatically run in
# high-fidelity Demo Mode backed by persistent browser LocalStorage, pre-populated
# with realistic academic and sustainability records (Elena Vance & Marcus Vance).

# ------------------------------------------------------------------------------
# Firebase Configuration (Optional: Dual-Mode Architecture)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# Gemini AI Configuration (Optional: Study Assistant Live Inference)
# ------------------------------------------------------------------------------
# Note: For production deployments, call Gemini via backend proxy or Cloud Functions.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Application Flags
# ------------------------------------------------------------------------------
VITE_APP_NAME="SmartCampus 360"
VITE_APP_ENV=development
